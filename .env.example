# BookScope 本地 key 配置示例。
#
# 用法：把这个文件复制成 .env，填上你自己的 key（BYOK）。
# .env 已进 .gitignore，不会入库——key 只留在你本机。
#
# 这些 key 只给本地 CLI 脚本用（probe / eval_retrieval / run_batch / smoke 等）。
# Web 前端走浏览器 BYOK，每次请求自带 key，不读这个文件。

# DeepSeek —— 默认 LLM，跑 agent / 伏笔 probe / batch 实验用。
# 拿 key：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# SiliconFlow —— 打开向量检索（hybrid，不填则检索退回纯 BM25）+ reranker 验证。
# 免费档即可（bge-m3 embedding + bge-reranker-v2-m3），不破"禁 GPU"红线。
# 拿 key：https://siliconflow.cn/
SILICONFLOW_API_KEY=

# ── Docker 部署用（docker compose 读这份 .env）──────────────────────────
# BYOK 原则：后端不碰用户的 LLM key，所以这里**不放任何 LLM key**。
# 上面两把 key 只给本地 CLI 脚本用，docker 部署不需要。

# Cloudflare 命名隧道 token（正式上线用）。留空 = 跑临时隧道 *.trycloudflare.com。
# 拿法：Cloudflare Zero Trust → Networks → Tunnels → Create → 装好后复制 TOKEN。
# 填了 TOKEN 后，还要把下面 TUNNEL_CMD 改成：tunnel run --token <填你的TOKEN>
# 并在 Zero Trust 的 Public Hostname 里绑 bookscope.top → http://api:8000。
TUNNEL_TOKEN=
TUNNEL_CMD=tunnel --url http://api:8000

# 上传体积上限（MB）。BYOK 下 LLM 走用户 key，但 ingest 吃服务器 CPU/带宽，护一下。
BOOKSCOPE_MAX_UPLOAD_MB=50

# CORS 允许来源（逗号分隔）。同源托管前端时留空即可（不触发 CORS）。
BOOKSCOPE_CORS_ORIGINS=

