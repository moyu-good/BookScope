{
  "name": "bookscope",
  "description": "BookScope 本地长文本工具：把书/公文/论文变成可核验、可交互、可追问的报告。适合作为 AI 助手的 tool/skill 被调用。",
  "version": "1.0.0",
  "tools": [
    {
      "name": "bookscope_import",
      "description": "导入本地文件或文件夹到书库，返回 session_id。零配置，不需要 LLM key。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件或文件夹绝对路径"
          },
          "title": {
            "type": "string",
            "description": "书名（可选，单文件时有效）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_report",
      "description": "给一个本地文件路径，生成结构版 HTML 书鉴报告（零 LLM）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件绝对路径"
          },
          "title": {
            "type": "string",
            "description": "书名（可选）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_ask",
      "description": "对一本书提问。有 LLM key 时智能回答；没有 key 时自动降级为本地检索返回相关原文。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "书库 session_id（来自 bookscope_import）"
          },
          "question": {
            "type": "string",
            "description": "用户问题"
          }
        },
        "required": [
          "session_id",
          "question"
        ]
      }
    },
    {
      "name": "bookscope_search",
      "description": "在一个文件夹里跨书本地检索关键词，返回相关原文片段。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          },
          "query": {
            "type": "string",
            "description": "关键词"
          },
          "top_k": {
            "type": "integer",
            "description": "每本书返回条数，默认 3"
          }
        },
        "required": [
          "path",
          "query"
        ]
      }
    },
    {
      "name": "bookscope_stats",
      "description": "统计一个书库文件夹的规模（本数/章数/字数）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_catalog",
      "description": "把一个文件夹生成可浏览的 HTML 书库目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          },
          "out": {
            "type": "string",
            "description": "输出目录，默认 bookscope-catalog"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_cross",
      "description": "两个本地文件直接出跨文本对照 HTML 报告（需要 LLM key）。",
      "parameters": {
        "type": "object",
        "properties": {
          "file1": {
            "type": "string",
            "description": "第一本书/文档路径"
          },
          "file2": {
            "type": "string",
            "description": "第二本书/文档路径"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "file1",
          "file2"
        ]
      }
    },
    {
      "name": "bookscope_cluster",
      "description": "多个文件（2-8）直接出簇关系网 HTML 报告（两两对照聚合，需要 LLM key）。",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "2-8 个文件路径"
          },
          "name": {
            "type": "string",
            "description": "簇/组名，默认 文档簇"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "files"
        ]
      }
    }
  ]
}
