{
  "name": "bookscope",
  "description": "BookScope 本地长文本工具：把书/公文/论文变成可核验、可交互、可追问的报告。适合作为 AI 助手的 tool/skill 被调用。",
  "version": "1.0.0",
  "tools": [
    {
      "name": "bookscope_import",
      "description": "导入本地文件或文件夹到书库，返回 session_id。零配置，不需要 LLM key。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "本地文件或文件夹绝对路径" },
          "title": { "type": "string", "description": "书名（可选，单文件时有效）" }
        },
        "required": ["path"]
      }
    },
    {
      "name": "bookscope_report",
      "description": "给一个本地文件路径，生成结构版 HTML 书鉴报告（零 LLM）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "本地文件绝对路径" },
          "title": { "type": "string", "description": "书名（可选）" }
        },
        "required": ["path"]
      }
    },
    {
      "name": "bookscope_ask",
      "description": "对一本书提问。有 LLM key 时智能回答；没有 key 时自动降级为本地检索返回相关原文。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string", "description": "书库 session_id（来自 bookscope_import）" },
          "question": { "type": "string", "description": "用户问题" }
        },
        "required": ["session_id", "question"]
      }
    },
    {
      "name": "bookscope_search",
      "description": "在一个文件夹里跨书本地检索关键词，返回相关原文片段。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "书库文件夹绝对路径" },
          "query": { "type": "string", "description": "关键词" },
          "top_k": { "type": "integer", "description": "每本书返回条数，默认 3" }
        },
        "required": ["path", "query"]
      }
    },
    {
      "name": "bookscope_stats",
      "description": "统计一个书库文件夹的规模（本数/章数/字数）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "书库文件夹绝对路径" }
        },
        "required": ["path"]
      }
    },
    {
      "name": "bookscope_catalog",
      "description": "把一个文件夹生成可浏览的 HTML 书库目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "书库文件夹绝对路径" },
          "out": { "type": "string", "description": "输出目录，默认 bookscope-catalog" }
        },
        "required": ["path"]
      }
    }
  ]
}
