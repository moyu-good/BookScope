{
  "name": "bookscope",
  "description": "BookScope 本地长文本工具：把书/公文/论文变成可核验、可交互、可追问的报告。适合作为 AI 助手的 tool/skill 被调用。",
  "version": "1.0.0",
  "tools": [
    {
      "name": "bookscope_import",
      "description": "导入本地文件或文件夹到书库，返回 session_id。AI 助手可直接调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件或文件夹绝对路径"
          },
          "title": {
            "type": "string",
            "description": "书名（可选，单文件时有效）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_report",
      "description": "给一个本地文件路径，生成结构版 HTML 书鉴报告（秒出，深度版就绪后自动升级）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件绝对路径"
          },
          "title": {
            "type": "string",
            "description": "书名（可选）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_ask",
      "description": "对一本书提问。有 LLM key 时智能回答；没有 key 时自动降级为本地检索返回相关原文。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "书库 session_id（来自 bookscope_import）"
          },
          "question": {
            "type": "string",
            "description": "用户问题"
          }
        },
        "required": [
          "session_id",
          "question"
        ]
      }
    },
    {
      "name": "bookscope_search",
      "description": "在一个文件夹里跨书本地检索关键词，返回相关原文片段。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          },
          "query": {
            "type": "string",
            "description": "关键词"
          },
          "top_k": {
            "type": "integer",
            "description": "每本书返回条数，默认 3"
          }
        },
        "required": [
          "path",
          "query"
        ]
      }
    },
    {
      "name": "bookscope_stats",
      "description": "统计一个书库文件夹的规模（本数/章数/字数）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_catalog",
      "description": "把一个文件夹生成可浏览的 HTML 书库目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "书库文件夹绝对路径"
          },
          "out": {
            "type": "string",
            "description": "输出目录，默认 bookscope-catalog"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_analyze",
      "description": "一键分析本地长文档：秒出结构版报告、查渐进进度、导入书库；有 LLM key 时自动后台预建深度章脉。AI 助手最简入口。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件绝对路径（epub/txt/pdf/docx/md）"
          },
          "title": {
            "type": "string",
            "description": "书名（可选）"
          },
          "question": {
            "type": "string",
            "description": "可选问题；不配 key 时返回本地检索原文片段"
          },
          "top_k": {
            "type": "integer",
            "description": "本地检索返回条数，默认 5"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_visualize",
      "description": "逻辑梳理 + 可视化综合报告：从长文档提取叙事曲线、人物/概念关系图、事件时间线、逻辑主线、论证结构、伏笔回收、前后一致性，输出一份移动端友好的 HTML。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "已导入书库的 session_id（与 path 二选一）"
          },
          "path": {
            "type": "string",
            "description": "本地文件路径（与 session_id 二选一）"
          },
          "concept": {
            "type": "string",
            "description": "要追踪的核心概念（可选，如 忠义 / 法治 / 市场）"
          },
          "unit": {
            "type": "string",
            "enum": ["person", "concept"],
            "description": "关系图分析单位，默认 person"
          },
          "mode": {
            "type": "string",
            "enum": ["full", "quick"],
            "description": "full=完整分析（默认）；quick=快速模式，只出主线/曲线/关系/时间线，耗时更短"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，AI 助手环境通常已自动提供）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          },
          "data": {
            "type": "object",
            "description": "预计算的分析结果 JSON（可选；用于离线/演示渲染）"
          }
        }
      }
    },
    {
      "name": "bookscope_deep_report",
      "description": "出一份认真版书鉴 HTML：深度章脉已就绪时直接给完整书鉴报告；未就绪时先给结构版并自动后台预建深度章脉（AI 助手有 LLM 能力时自动启用）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件绝对路径"
          },
          "title": {
            "type": "string",
            "description": "书名（可选）"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，AI 助手环境通常已自动提供）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_verify",
      "description": "对一句引文在本地原文里做逐字核验。找到逐字命中返回 verified=true；找不到明确返回 false，不冒充已核验。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地原文文件绝对路径"
          },
          "quote": {
            "type": "string",
            "description": "要核验的引文"
          },
          "context_chars": {
            "type": "integer",
            "description": "返回上下文宽度，默认 120"
          }
        },
        "required": [
          "path",
          "quote"
        ]
      }
    },
    {
      "name": "bookscope_prewarm",
      "description": "对已导入书库的一本书后台预建深度章脉（渐进交付：先返回，后台按章构建，之后用 bookscope_progress 看进度）。AI 助手有 LLM 能力时自动启用。",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "书库 session_id（来自 bookscope_import）"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "bookscope_progress",
      "description": "查看一本书的深度章脉构建进度（只读缓存）。用于渐进交付：没建完时先给结构版，建完再给深度版。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本地文件绝对路径"
          },
          "model": {
            "type": "string",
            "description": "章脉缓存使用的模型名，默认 deepseek-v4-flash"
          },
          "genre": {
            "type": "string",
            "description": "章脉体裁，默认 fiction"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "bookscope_cross",
      "description": "两个本地文件直接出跨文本对照 HTML 报告。",
      "parameters": {
        "type": "object",
        "properties": {
          "file1": {
            "type": "string",
            "description": "第一本书/文档路径"
          },
          "file2": {
            "type": "string",
            "description": "第二本书/文档路径"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "file1",
          "file2"
        ]
      }
    },
    {
      "name": "bookscope_cluster",
      "description": "多个文件（2-8）直接出簇关系网 HTML 报告（两两对照聚合）。",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "2-8 个文件路径"
          },
          "name": {
            "type": "string",
            "description": "簇/组名，默认 文档簇"
          },
          "api_key": {
            "type": "string",
            "description": "LLM API key（可选，默认读环境变量）"
          },
          "provider": {
            "type": "string",
            "description": "默认 deepseek"
          },
          "model": {
            "type": "string",
            "description": "默认 deepseek-v4-flash"
          },
          "base_url": {
            "type": "string",
            "description": "OpenAI 兼容 base_url（可选）"
          }
        },
        "required": [
          "files"
        ]
      }
    }
  ]
}
